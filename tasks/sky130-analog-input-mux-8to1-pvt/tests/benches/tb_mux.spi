let gain_i7 = db(v(VO_I7))
meas ac gain_dc_s7_i7 FIND gain_i7 AT=0.001
meas ac gain_1m_s7_i7 FIND gain_i7 AT=1Meg
let bw_target_s7 = gain_dc_s7_i7 * 0.707945784384138
meas ac bw_s7 WHEN gain_i7=$&bw_target_s7 FALL=1
op
let idc_s7 = abs(i(VDD))/8
print idc_s7
quit
.endc
.end
